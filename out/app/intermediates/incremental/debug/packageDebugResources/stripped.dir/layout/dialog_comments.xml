<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_feed_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bình luận"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_comments"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tv_dialog_comment_replying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_action_pill_outline"
        android:padding="10dp"
        android:textColor="#1D4ED8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_dialog_comment_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:hint="Viết bình luận..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_dialog_comment_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_pill"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@android:color/white" />

    </LinearLayout>

</LinearLayout>