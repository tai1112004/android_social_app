<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_clean_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trả lời story"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_story_reply_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_clean_pill"
        android:padding="12dp"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_story_reply_input"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_clean_pill"
        android:gravity="top"
        android:hint="Bạn đang nghĩ gì?"
        android:inputType="textMultiLine"
        android:padding="14dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_story_reply_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_clean_pill"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Hủy"
            android:textColor="#1D4ED8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_story_reply_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_action_pill_filled"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Gửi"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>