<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SocialApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/social_blue</item>
        <item name="colorPrimaryVariant">@color/social_blue_dark</item>
        <item name="colorSecondary">@color/social_accent</item>
        <item name="colorSecondaryVariant">@color/social_accent_dark</item>
        <item name="colorError">@color/red_500</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/social_background</item>
        <item name="android:colorBackground">@color/social_background</item>
        <item name="android:statusBarColor">@color/social_surface</item>
        <item name="android:navigationBarColor">@color/social_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
