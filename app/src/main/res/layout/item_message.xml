<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/tv_message_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="U"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/message_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_message_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="3dp"
                android:textColor="#65676B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_message_reply"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_story_preview_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_message_reply_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="da chia se mot tin"
                    android:textColor="#8E8E8E"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <FrameLayout
                    android:id="@+id/frame_story_preview_media"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/iv_message_reply_media"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_story_overlay" />
                    <TextView
                        android:id="@+id/tv_message_reply_author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_message_reply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:textColor="#1C1E21"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1C1E21"
                android:textSize="15sp"
                android:lineSpacingExtra="1dp" />

            <FrameLayout
                android:id="@+id/media_frame"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_media_clip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/iv_message_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@+id/tv_video_badge"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_send_button"
                    android:gravity="center"
                    android:text=">"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8E8E8E"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_message_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_reaction_float"
            android:elevation="6dp"
            android:minWidth="28dp"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="#111827"
            android:textSize="16sp"
            android:translationY="-1dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>