<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_bar_overlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="86dp"
    android:background="@drawable/bg_story_music_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/iv_overlay_music_cover"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_music_cover"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_overlay_music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_overlay_music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal">
        <View android:id="@+id/music_wave_1" android:layout_width="3dp" android:layout_height="8dp" android:background="@drawable/bg_wave_bar" />
        <View android:id="@+id/music_wave_2" android:layout_width="3dp" android:layout_height="13dp" android:layout_marginStart="3dp" android:background="@drawable/bg_wave_bar" />
        <View android:id="@+id/music_wave_3" android:layout_width="3dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:background="@drawable/bg_wave_bar" />
    </LinearLayout>
</LinearLayout>
