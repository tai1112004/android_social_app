<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tạo tin mới"
        android:textColor="#111827"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chọn ảnh và gắn nhạc preview 30s nếu muốn."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- Nút Thêm nhạc: Pill button, background #1C1E21 60% opacity, bo tròn 20dp -->
    <LinearLayout
        android:id="@+id/layout_story_add_music"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_story_music_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_music_note"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/btn_story_add_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:text="Thêm nhạc"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Nút X nhỏ bên cạnh tên bài hát để bỏ chọn nhanh -->
        <TextView
            android:id="@+id/btn_story_remove_music_pill"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="✕"
            android:textColor="#E5E7EB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Thanh nhạc mini preview (hiện sau khi chọn xong): background #1C1E21 80% opacity, bo tròn 12dp -->
    <LinearLayout
        android:id="@+id/story_music_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_story_music_preview"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <!-- Ảnh album 40dp, bo tròn 6dp -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/iv_story_music_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Giữa: Tên bài (marquee) và tên nghệ sĩ (70% opacity) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_story_music_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_story_music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút ▶/⏸ Preview 30s trước khi đăng -->
        <TextView
            android:id="@+id/btn_story_play_preview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_story_remove_music"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_story_choose_image"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_fb_primary_button"
        android:gravity="center"
        android:text="Chọn ảnh để đăng tin"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
