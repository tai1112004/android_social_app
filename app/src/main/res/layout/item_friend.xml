<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_list_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">

        <TextView
            android:id="@+id/tv_friend_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="U"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_online_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_offline_dot" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_friend_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_friend_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7280"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_friend_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_friend_message"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_soft_pill"
            android:minWidth="58dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Nhắn"
            android:textColor="#2563EB"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_friend_unfriend"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_soft_pill"
            android:minWidth="72dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Hủy KB"
            android:textColor="#DC2626"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_friend_block"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_soft_pill"
            android:minWidth="58dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Chặn"
            android:textColor="#111827"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_friend_action"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_soft_pill"
        android:minWidth="72dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Nhắn tin"
        android:textColor="#2563EB"
        android:textSize="11sp" />

</LinearLayout>